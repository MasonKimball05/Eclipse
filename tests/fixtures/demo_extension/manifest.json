{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "A tiny extension the tests (and you) can use to check the runtime.",
  "version": "1.0",
  "default_locale": "en",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Demo"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "webRequest",
    "nativeMessaging"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*"
    ]
  }
}
